# Copy this file to .env and adjust values as needed.
# .env is gitignored - real credentials never get committed.
# Every variable here has a safe default baked into docker-compose.yml,
# so `docker compose up` works with zero setup even without a .env file.
# This file only matters when you need to override something - e.g.
# deploying somewhere with a real database, or avoiding a local port clash.

POSTGRES_DB=truebid
POSTGRES_USER=truebid
POSTGRES_PASSWORD=truebid_local_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_ANONYMOUS=true   # uncomment to skip the login screen for a demo

# JWT_SECRET: the default below is a placeholder that only works locally.
# gateway/src/auth.ts's assertAuthConfigSafe() refuses to boot if
# NODE_ENV=production and this is still set to the placeholder - so
# there's no way to accidentally deploy with it. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=truebid-local-dev-insecure-secret-change-me
JWT_EXPIRY=2h
RATE_LIMIT_HTTP_WINDOW_MS=60000
RATE_LIMIT_HTTP_MAX=120
RATE_LIMIT_WS_MAX_CONNECTIONS=10
RATE_LIMIT_WS_WINDOW_MS=60000

JAEGER_UI_PORT=16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318   # override if pointing at a different collector/backend

# Optional - see README "What's intentionally left as a stub" section.
# Leave unset to use the angle-completeness-only repair confidence signal.
# PHOTO_ANALYSIS_URL=

# --------------------------------------------------------------------
# Everything below is ONLY used by docker-compose.prod.yml (a real,
# public deployment) - none of it is needed for local `docker compose
# up`. Compose will refuse to start docker-compose.prod.yml at all until
# every one of these is actually set to something real (see that file's
# ${VAR:?...} required-variable syntax) - there is no insecure fallback
# to accidentally deploy with. See docs/HOSTING.md for the full
# deployment walkthrough.
# --------------------------------------------------------------------

# Point these at this server's IP with an A record each *before* starting
# the stack - Caddy's automatic HTTPS (Let's Encrypt) needs that to
# succeed on first boot.
# DOMAIN=truebid.yourdomain.com
# GRAFANA_DOMAIN=monitoring.yourdomain.com
# ACME_EMAIL=you@example.com

# Real secrets for a public deployment - do not reuse the local-dev
# defaults above.
# POSTGRES_PASSWORD=<generate with: openssl rand -base64 32>
# JWT_SECRET=<generate with: openssl rand -base64 48>
# GRAFANA_ADMIN_PASSWORD=<a real password, not "admin">
